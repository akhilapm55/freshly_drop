# Copy this file to ".env.local" and fill in your real Supabase values.
# Find both in your Supabase dashboard under: Project Settings -> API
#
# After editing .env.local you MUST restart the dev server (npm run dev).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# OPTIONAL — Google Maps. Enables Places Autocomplete (address search) and
# accurate DRIVING distance. Needs "Maps JavaScript API" + "Distance Matrix API"
# with billing (Google's $200/month free credit covers small usage).
# Without it, the app uses free OpenStreetMap address search + straight-line distance.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
